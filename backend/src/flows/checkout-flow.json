    {
      "id": "CHECKOUT_REVIEW",
      "title": "${data.ui_screen_title}",
      "terminal": true,
      "data": {
        "ui_screen_title": {
          "type": "string",
          "__example__": "Review order"
        },
        "ui_name_label": {
          "type": "string",
          "__example__": "Name"
        },
        "ui_type_label": {
          "type": "string",
          "__example__": "Type"
        },
        "ui_address_choice_label": {
          "type": "string",
          "__example__": "Delivery address"
        },
        "ui_address_label": {
          "type": "string",
          "__example__": "Street"
        },
        "ui_apartment_label": {
          "type": "string",
          "__example__": "Apartment"
        },
        "ui_apartment_helper": {
          "type": "string",
          "__example__": "Stiege / Tür / Top, or Haus if none"
        },
        "ui_note_label": {
          "type": "string",
          "__example__": "Note"
        },
        "ui_back_to_cart": {
          "type": "string",
          "__example__": "Back to cart"
        },
        "ui_place_order": {
          "type": "string",
          "__example__": "Place order"
        },
        "ui_manage_addresses_link": {
          "type": "string",
          "__example__": "Manage addresses"
        },
        "receipt_text": {
          "type": "string",
          "__example__": "1x Chicken Dürüm  €8.50\n1x Falafel Box  €6.90\n\nTotal: €15.40"
        },
        "customer_name": {
          "type": "string",
          "__example__": "Alex Smith"
        },
        "order_type": {
          "type": "string",
          "__example__": "delivery"
        },
        "order_type_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "pickup",
              "title": "Pickup"
            },
            {
              "id": "delivery",
              "title": "Delivery"
            }
          ]
        },
        "address_choice": {
          "type": "string",
          "__example__": "addr_0"
        },
        "address_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "addr_0",
              "title": "Hippgasse 11",
              "description": "Top 14, 1160 Wien"
            },
            {
              "id": "addr_1",
              "title": "Naschmarkt 5",
              "description": "1040 Wien"
            },
            {
              "id": "addr_new",
              "title": "New address",
              "description": "Enter street and apartment below"
            }
          ]
        },
        "delivery_address": {
          "type": "string",
          "__example__": "Hippgasse 11, 1160 Wien"
        },
        "delivery_apartment": {
          "type": "string",
          "__example__": "Top 14"
        },
        "note": {
          "type": "string",
          "__example__": "Please ring the bell."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "checkout_form",
            "init-values": {
              "customer_name": "${data.customer_name}",
              "order_type": "${data.order_type}",
              "address_choice": "${data.address_choice}",
              "delivery_address": "${data.delivery_address}",
              "delivery_apartment": "${data.delivery_apartment}",
              "note": "${data.note}"
            },
            "children": [
              {
                "type": "TextBody",
                "text": "${data.receipt_text}"
              },
              {
                "type": "TextInput",
                "label": "${data.ui_name_label}",
                "name": "customer_name",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "label": "${data.ui_type_label}",
                "name": "order_type",
                "required": true,
                "data-source": "${data.order_type_options}"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "${data.ui_address_choice_label}",
                "name": "address_choice",
                "required": true,
                "data-source": "${data.address_options}"
              },
              {
                "type": "TextInput",
                "label": "${data.ui_address_label}",
                "name": "delivery_address",
                "required": true
              },
              {
                "type": "TextInput",
                "label": "${data.ui_apartment_label}",
                "name": "delivery_apartment",
                "required": true,
                "helper-text": "${data.ui_apartment_helper}"
              },
              {
                "type": "TextArea",
                "label": "${data.ui_note_label}",
                "name": "note",
                "required": false
              },
              {
                "type": "EmbeddedLink",
                "text": "${data.ui_manage_addresses_link}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "checkout_action": "manage_addresses"
                  }
                }
              },
              {
                "type": "EmbeddedLink",
                "text": "${data.ui_back_to_cart}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "checkout_action": "back_to_cart"
                  }
                }
              },
              {
                "type": "Footer",
                "label": "${data.ui_place_order}",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "checkout_action": "place_order",
                    "customer_name": "${form.customer_name}",
                    "order_type": "${form.order_type}",
                    "address_choice": "${form.address_choice}",
                    "delivery_address": "${form.delivery_address}",
                    "delivery_apartment": "${form.delivery_apartment}",
                    "note": "${form.note}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
