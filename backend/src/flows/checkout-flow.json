  "data_api_version": "3.0",
  "routing_model": {
    "CHECKOUT_REVIEW": [
      "ADDRESS_MANAGE"
    ],
    "ADDRESS_MANAGE": [
      "ADDRESS_MANAGE_UPDATED",
      "CHECKOUT_REVIEW_RETURN"
    ],
    "ADDRESS_MANAGE_UPDATED": [
